NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
# For Atlas, replace this with your connection URI. MONGODB_DATABASE selects the target database.
MONGODB_URI=mongodb://127.0.0.1:27017/RestoPilot
MONGODB_DATABASE=RestoPilot
# Optional Atlas URI for the API container when using Docker Compose.
MONGODB_ATLAS_URI=
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=use-a-different-random-secret-at-least-32-characters
SEED_RESTAURANT_NAME=
SEED_RESTAURANT_SLUG=
SEED_WHATSAPP_NUMBER=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
OPENAI_API_KEY=replace-me
GEMINI_API_KEY=replace-me
