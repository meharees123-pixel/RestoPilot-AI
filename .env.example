NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
# For Atlas, replace this with your connection URI. MONGODB_DATABASE selects the target database.
MONGODB_URI=mongodb://127.0.0.1:27017/RestoPilot
MONGODB_DATABASE=RestoPilot
# Optional Atlas URI for the API container when using Docker Compose.
MONGODB_ATLAS_URI=
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=use-a-different-random-secret-at-least-32-characters
# One-time platform-admin bootstrap; restaurant users use WhatsApp OTP, not passwords.
SEED_RESTAURANT_NAME=
SEED_RESTAURANT_SLUG=
SEED_WHATSAPP_NUMBER=
SEED_OWNER_FIRST_NAME=
SEED_OWNER_LAST_NAME=
SEED_OWNER_PHONE_NUMBER=
SEED_OWNER_EMAIL=
SEED_SUPER_ADMIN_FIRST_NAME=
SEED_SUPER_ADMIN_LAST_NAME=
SEED_SUPER_ADMIN_PHONE_NUMBER=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_MFA_SECRET=
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE_NAME=restopilot_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# Optional dedicated HMAC key for OTP hashes; defaults to JWT_SECRET.
OTP_HASH_SECRET=
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
# Set to true temporarily in local development to diagnose unsigned webhook requests.
WHATSAPP_DEBUG_BYPASS_SIGNATURE=false
# Optional public callback URL for startup diagnostics only.
# WHATSAPP_WEBHOOK_URL=https://your-ngrok-host/api/v1/webhooks/whatsapp
# WHATSAPP_DEBUG_LOGGING defaults to true outside production; set false to suppress body/message logs.
# In production, enable only temporarily because message content and sender phone are personal data.
OPENAI_API_KEY=replace-me
GEMINI_API_KEY=replace-me
